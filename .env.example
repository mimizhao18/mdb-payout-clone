# Copy this file to .env.local and fill in your own values.
# Find them in the Supabase dashboard: Project Settings -> API Keys / Connect.
# Only the PUBLISHABLE key belongs here. Never put the secret / service_role key
# in an EXPO_PUBLIC_ variable: those are readable inside the shipped app.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
